{
  "project": "free-period-website",
  "baseUrl": "https://free-period-website.pages.dev",
  "outDir": "docs/showcase",

  "viewports": {
    "desktop": { "width": 1280, "height": 800, "deviceScaleFactor": 2 },
    "mobile":  { "width": 390,  "height": 844,  "deviceScaleFactor": 3, "isMobile": true }
  },

  "reducedMotion": "reduce",

  "pages": [
    {
      "label": "hero",
      "url": "/",
      "viewport": "desktop",
      "fullPage": false,
      "before": [
        { "action": "wait", "ms": 2000 }
      ]
    },
    {
      "label": "features",
      "url": "/",
      "viewport": "desktop",
      "fullPage": false,
      "before": [
        { "action": "wait", "ms": 2000 },
        { "action": "scroll", "by": 500 },
        { "action": "wait", "ms": 800 }
      ]
    },
    {
      "label": "products",
      "url": "/products/",
      "viewport": "desktop",
      "fullPage": false,
      "before": [
        { "action": "wait", "ms": 2500 }
      ]
    },
    {
      "label": "mobile-hero",
      "url": "/",
      "viewport": "mobile",
      "fullPage": false,
      "before": [
        { "action": "wait", "ms": 2000 }
      ]
    }
  ],

  "demo": {
    "size": { "width": 1280, "height": 720 },
    "stepPauseMs": 400,
    "steps": [
      { "action": "goto", "url": "/", "timeoutMs": 15000 },
      { "action": "wait", "ms": 3000 },
      { "action": "scroll", "by": 350 },
      { "action": "wait", "ms": 1500 },
      { "action": "scroll", "by": 400 },
      { "action": "wait", "ms": 1800 },
      { "action": "goto", "url": "/products/", "timeoutMs": 10000 },
      { "action": "wait", "ms": 2500 },
      { "action": "scroll", "by": 400 },
      { "action": "wait", "ms": 1800 }
    ]
  }
}
